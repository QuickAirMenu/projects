# ============================================
# iProjects - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Each instance (client) has its own .env

# Application
APP_NAME="iProjects - [Client Name]"
APP_ENV=production  # production | staging | local
APP_KEY=            # Run: php artisan key:generate
APP_DEBUG=false     # true only for staging/dev
APP_URL=https://[subdomain].i-projects.net

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error  # debug | info | warning | error

# Database (per-instance)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u227212075_[db_name]
DB_USERNAME=u227212075_[db_name]
DB_PASSWORD="[your_password]"

# Cache & Sessions
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Redis (for VPS phase)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=[smtp_host]
MAIL_PORT=587
MAIL_USERNAME=[smtp_user]
MAIL_PASSWORD=[smtp_pass]
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@[subdomain].i-projects.net"
MAIL_FROM_NAME="${APP_NAME}"

# Workspace Settings
WORKSPACE_TIMEZONE=Asia/Riyadh
WORKSPACE_DEFAULT_LANGUAGE=ar  # ar | en
WORKSPACE_TAX_RATE=15
WORKSPACE_CURRENCY=SAR
WORKSPACE_DATE_FORMAT="Y-m-d"
WORKSPACE_TIME_FORMAT="H:i"

# Third-party APIs
TINIFY_API_KEY=[your_tinify_key]
